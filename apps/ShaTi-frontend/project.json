{
  "name": "frontend",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/ShaTi-frontend"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "apps/ShaTi-frontend"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm wrangler:deploy",
        "cwd": "apps/ShaTi-frontend"
      }
    },
    "non-prod-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm wrangler:non-prod-deploy",
        "cwd": "apps/ShaTi-frontend"
      }
    },
    "lint": {
      "executor": "nx-oxlint:lint"
    }
  }
}